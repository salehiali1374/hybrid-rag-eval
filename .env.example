# Copy to .env (git-ignored) and fill in. /health and /search work without any of this.

# An OpenAI-compatible chat endpoint. From inside the container, an Ollama on the host is
# http://host.docker.internal:11434/v1 (Ollama must listen on 0.0.0.0, not only on 127.0.0.1).
HRE_LLM_BASE_URL=https://openrouter.ai/api/v1
HRE_LLM_MODEL=
HRE_LLM_API_KEY=

# Loads a ~2.3 GB cross-encoder so that "rerank": true works (about 12 s per question on CPU).
# HRE_LOAD_RERANKER=true
